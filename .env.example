# ─────────────────────────────────────────────────────────────────────────────
# OpenClaw Pack — Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Agent Identity ────────────────────────────────────────────────────────────
AGENT_NAME="Falcon"
AGENT_EMOJI="🦅"
ORG_NAME="Your Company"
OWNER_NAME="Your Name"
OWNER_TIMEZONE="Africa/Lagos"

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (optional)
# OPENAI_API_KEY=sk-...

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABC...
TELEGRAM_OWNER_ID=123456789

# ── Mission Control ───────────────────────────────────────────────────────────
MC_URL=https://mc.curatelearn.com
MC_AGENT_TOKEN=mc_...
MC_AGENT_ID=main

# ── Gateway ───────────────────────────────────────────────────────────────────
GATEWAY_PORT=18789
# Leave blank to auto-generate
GATEWAY_TOKEN=
